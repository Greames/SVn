# Copy this file to .env and fill in local values.
# Never commit .env or any file containing real credentials.

# Postgres connection string used by Prisma.
# Matches the default credentials in docker-compose.yml for local dev.
DATABASE_URL="postgresql://homeservices:homeservices@localhost:5432/homeservices?schema=public"

# Reserved for Auth.js (NextAuth) once authentication is implemented.
# Not used yet — no auth flows exist in this scaffold.
# AUTH_SECRET=
# AUTH_URL="http://localhost:3000"
